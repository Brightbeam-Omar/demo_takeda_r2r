# R2R Intelligence Demo: copy to .env (`cp .env.example .env`). .env is gitignored.
# Every value below is a local-development default. The feature that uses each variable is named in its comment.

# --- Postgres (F01) ---
# One server, five databases: erp_sim, lims_sim, qms_sim, app, dagster.
# Per-DB DSN pattern used by services (F04+):
#   postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/<database>
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=r2r
POSTGRES_PASSWORD=r2r_dev_only

# --- Sync layer (F07 notify, F08 receiver and worker) ---
# HMAC key shared by the pipeline (signs) and app-api (verifies). Dev-only placeholder.
WEBHOOK_SECRET=dev-only-change-me
# Where the pipeline POSTs the signed webhook after a successful run (F07).
WEBHOOK_URL=http://app-api:8000/api/sync/webhook
# Seconds between drain-worker passes (F08).
DRAIN_INTERVAL_SECONDS=20

# --- Lakehouse and site profile (F03, F06, F07, F08) ---
# Delta lakehouse path inside containers; mounted from ./lakehouse.
LAKEHOUSE_PATH=/lakehouse
# Site profile name loaded from config/site-profiles/ (F03).
SITE_PROFILE=site_a

# --- Demo clock and scenario service (F03 clock reader, F04 service, F13 steps) ---
# How r2r_core.clock.now() finds demo time: http | db | fixed.
CLOCK_SOURCE=http
SCENARIO_URL=http://scenario:8100
# Bearer token for clock/scenario write endpoints. Dev-only placeholder.
SCENARIO_TOKEN=dev-only-change-me

# --- Orchestration (F07, F13) ---
DAGSTER_GRAPHQL_URL=http://dagster-web:3001/graphql

# --- Agents and LLM (F12; cost meter in Tier 2) ---
# replay (offline, deterministic) | anthropic | bedrock
LLM_PROVIDER=replay
# Leave empty unless LLM_PROVIDER=anthropic or recording replays (make record-agents).
ANTHROPIC_API_KEY=
MODEL_ID=claude-sonnet-5-5
# Run the air-gap agent automatically after each sync (F12).
AGENTS_AUTORUN=false
# Illustrative prices (USD per 1K tokens) for the cost meter (F12 / T2-06). Replace with current rates.
LLM_PRICE_IN_PER_1K=0.003
LLM_PRICE_OUT_PER_1K=0.015
# AWS region for the Bedrock provider (Tier 2: T2-10).
AWS_REGION=eu-west-1

# --- Leak scanner (F02) ---
# LEAKSCAN_DENYLIST: CI only, set as a GitHub secret; locally use .leakscan/denylist.txt
# (copy .leakscan/denylist.example.txt). The variable holds the list itself, not a path.

# --- Demo mode (F09 persona header, F10 persona switcher, F13 demo controls) ---
DEMO_MODE=true
